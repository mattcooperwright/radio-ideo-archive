rules_version = '2';

// The browser never talks to Firestore. Every read and write goes through the server with the
// Admin SDK, which ignores these rules. Deny everything else, so the public web config in the
// client bundle cannot be used to read or write the plays collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
